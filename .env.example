# Variables de entorno para el proyecto TP Programación III — Taller mecánica
# Copiar este archivo a .env y completar los valores sensibles.
# El archivo .env NO se versiona.

POSTGRES_USER=taller
POSTGRES_PASSWORD=cambiar_esta_contraseña
POSTGRES_DB=taller_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clave de firma de JWT (SECRETO — generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar_esta_clave_por_una_secreta

# Costo de bcrypt (se puede subir con los años)
BCRYPT_COST=12

# Habilitar logging de SQL en consola (para diagnóstico)
SQL_ECHO=false

# Cookie de sesión: marcar Secure solo cuando la API se sirve por TLS
COOKIE_SECURE=false

# Vigencia del token de acceso, en minutos
JWT_EXPIRES_MINUTES=30

# Límite de intentos fallidos de login por correo y dirección
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=60
